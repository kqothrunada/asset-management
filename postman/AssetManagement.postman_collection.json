          "name": "List roles",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/roles"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json().find(x => x.name === 'User'); if (r) pm.collectionVariables.set('roleId', r.id);"
                ]
              }
