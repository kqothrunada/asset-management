    {
      "name": "2. REST - Assets (login leo atau jane)",
      "item": [
        {
          "name": "Lookups - categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/lookups/categories"
          }
        },
        {
          "name": "Lookups - users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/lookups/users"
          }
        },
        {
          "name": "Create asset (AST-xxx)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/assets",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop Dell\",\n  \"description\": \"<p>Laptop untuk developer</p>\",\n  \"category\": \"ITEquipment\",\n  \"subcategory\": \"Laptop\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json(); pm.collectionVariables.set('assetId', j.id); pm.test('assetCode AST-', () => pm.expect(j.assetCode).to.match(/^AST-\\d{3,}$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create asset - invalid (tanpa description -> 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/assets",
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"X\", \"category\": \"ITEquipment\", \"subcategory\": \"Laptop\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "List assets",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/assets?page=1&pageSize=10"
          }
        },
        {
          "name": "Get asset",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/assets/{{assetId}}"
          }
        },
        {
          "name": "Update asset",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/assets/{{assetId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop Dell\",\n  \"description\": \"<p>Laptop untuk developer</p>\",\n  \"category\": \"ITEquipment\",\n  \"subcategory\": \"Laptop\",\n  \"status\": \"New\"\n}"
            }
          }
        },
        {
          "name": "Delete asset (Manager)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/assets/{{assetId}}"
          }
        },
        {
          "name": "Export Excel (hanya HQ Manager = sarah)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/assets/export"
          }
        }
      ]
    },
    {
      "name": "3. REST - Maintenance",
      "item": [
        {
          "name": "List maintenance",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/assets/{{assetId}}/maintenances"
          }
        },
        {
          "name": "Add maintenance (total ter-update)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/assets/{{assetId}}/maintenances",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cost\": 250000.5,\n  \"type\": \"Preventive\",\n  \"vendor\": \"PT Servis\",\n  \"comments\": \"Ganti thermal paste\",\n  \"date\": \"2026-10-21\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json(); pm.collectionVariables.set('maintId', j.maintenance.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update maintenance",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/assets/{{assetId}}/maintenances/{{maintId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"cost\": 100000, \"type\": \"Corrective\", \"vendor\": \"PT Servis\", \"date\": \"2026-10-22\"}"
            }
          }
        },
        {
          "name": "Delete maintenance",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/assets/{{assetId}}/maintenances/{{maintId}}"
          }
        }
      ]
    },
    {
      "name": "4. REST - Approval workflow",
      "item": [
        {
          "name": "Start review (jane/leo): status -> UnderReview",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/assets/{{assetId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop Dell\",\n  \"description\": \"<p>Laptop untuk developer</p>\",\n  \"category\": \"ITEquipment\",\n  \"subcategory\": \"Laptop\",\n  \"status\": \"UnderReview\"\n}"
            }
          }
        },
        {
          "name": "List approvals",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/assets/{{assetId}}/approvals"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const a = pm.response.json();",
                  "const h = a.find(x => x.role === 'Department Head'), m = a.find(x => x.role === 'Asset Manager');",
                  "if (h) pm.collectionVariables.set('approvalHeadId', h.id); if (m) pm.collectionVariables.set('approvalMgrId', m.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve - Department Head (login leo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/approvals/{{approvalHeadId}}/approve",
            "body": {
              "mode": "raw",
              "raw": "{\"notes\": \"OK\"}"
            }
          }
        },
        {
          "name": "Approve - Asset Manager (login sarah)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/approvals/{{approvalMgrId}}/approve",
            "body": {
              "mode": "raw",
              "raw": "{\"notes\": \"OK\"}"
            }
          }
        },
        {
          "name": "Reject - Department Head (notes wajib)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/approvals/{{approvalHeadId}}/reject",
            "body": {
              "mode": "raw",
              "raw": "{\"notes\": \"Tidak sesuai kebutuhan\"}"
            }
          }
        }
      ]
    },
