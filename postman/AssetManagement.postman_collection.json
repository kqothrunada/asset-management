{
  "info": {
    "name": "Asset Management API",
    "description": "Jalankan '1. Auth' dulu untuk menyimpan token. Ganti variabel baseUrl: Docker = http://localhost:5000, dotnet run = port di launchSettings.json.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "assetId",
      "value": "1"
    },
    {
      "key": "maintId",
      "value": "1"
    },
    {
      "key": "approvalHeadId",
      "value": "1"
    },
    {
      "key": "approvalMgrId",
      "value": "2"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "roleId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth (jalankan login dulu; token tersimpan otomatis)",
      "item": [
        {
          "name": "Login - sarah",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"sarah\",\n  \"password\": \"Pass1234!\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
